# Spring 백엔드 주소
# AWS 배포 시: 이미지는 커밋 1개당 한 번만 빌드돼 여러 환경에서 재사용되므로,
# 빌드 시엔 플레이스홀더(__VITE_API_BASE_URL__)만 박고 컨테이너 시작 시(entrypoint) 실제 값으로 치환한다.
# 즉 --build-arg가 아니라 컨테이너 실행 시 -e VITE_API_BASE_URL=http://EC2_PUBLIC_IP:8080 로 넘길 것 (이 파일 값은 로컬 전용).
VITE_API_BASE_URL=http://localhost:8080

# 기본 실 API(서버 데이터). API 실패 시 mock 폴백을 원하면 true.
# (하드 스위치 아님 — 코드는 항상 실 API 먼저 호출, true일 때만 실패 시 mock 폴백)
VITE_USE_MOCK=false
